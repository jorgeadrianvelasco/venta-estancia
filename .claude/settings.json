{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "language": "spanish",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Read",
      "Grep",
      "Glob",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "mcp__Canva",
      "mcp__Higgsfield__media_upload",
      "mcp__Higgsfield__media_confirm",
      "mcp__Higgsfield__upscale_image",
      "mcp__Higgsfield__generate_image",
      "mcp__Higgsfield__jobs_wait",
      "mcp__Higgsfield__balance",
      "mcp__Higgsfield__models_explore",
      "mcp__Higgsfield__get_preferences",
      "mcp__Higgsfield__show_generation_by_ids",
      "mcp__Higgsfield__job_display"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/inicio-sesion.sh\"",
            "timeout": 15,
            "statusMessage": "Cargando el estado de la venta de la estancia..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/despues-de-commit.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/cierre-memoria.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
